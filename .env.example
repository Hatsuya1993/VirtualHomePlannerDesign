# Automatic Recognition (floor-plan → walls) uses the Anthropic Claude vision
# API. Copy this file to `.env`, fill in your key, then restart the bundler
# with a cleared cache:  npx expo start -c
#
# EXPO_PUBLIC_ vars are inlined into the app bundle, so the key ships with the
# build and is extractable. For production, proxy the request through a backend
# and keep the key server-side instead.

EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — override the vision model (default: claude-sonnet-5)
# EXPO_PUBLIC_ANTHROPIC_MODEL=claude-sonnet-5

# AI Redesign (compose an item into a room photo) uses Google's Gemini image
# model. Get a key from Google AI Studio (https://aistudio.google.com/apikey).
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-key-here

# Optional — override the image model (default: gemini-3.1-flash-image)
# EXPO_PUBLIC_GEMINI_MODEL=gemini-3.1-flash-image

# Firebase Authentication. From the Firebase console: Project settings →
# General → Your apps → (Web app) → SDK setup and configuration → Config.
# These are client-side config values (not secrets), safe to expose.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In — the *Web* OAuth client ID from Google Cloud (the one Firebase
# auto-creates when you enable the Google provider). Ends in
# .apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# NOTE: the iOS *reversed* client ID goes in app.json under the
# @react-native-google-signin/google-signin plugin's "iosUrlScheme".
