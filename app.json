{
  "expo": {
    "name": "VirtualHomePlannerDesign",
    "slug": "VirtualHomePlannerDesign",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3d9faa5c-03b6-46d0-ac9c-2818aa7c6d42"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hatsuya.VirtualHomePlannerDesign",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hatsuya.VirtualHomePlannerDesign",
      "adaptiveIcon": {
        "backgroundColor": "#4644C0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "./plugins/withOptionalPortrait",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to upload a floor plan.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to capture a floor plan.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-sharing",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.933172065693-g0h8lfkal87jfgbneith3dmophks796h"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "room-planner-home-3d-design",
          "organization": "muhammadnurhazrul"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F7FB"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3d9faa5c-03b6-46d0-ac9c-2818aa7c6d42"
      }
    }
  }
}
